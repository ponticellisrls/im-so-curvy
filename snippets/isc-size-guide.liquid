{%- comment -%}
  I'M So Curvy: guida alle taglie in un pannello (si apre da "Guida alle taglie" nel selettore taglie).
  Accepts:
  - block: {Object} blocco variant_picker (isc_size_head, isc_size_table, isc_size_tip)
  - product: {Object}
{%- endcomment -%}
{%- assign rows = block.settings.isc_size_table | newline_to_br | split: '<br />' -%}
<isc-size-guide class="isc-sg">
  <dialog class="isc-sg__dialog" aria-labelledby="IscSizeGuide-{{ product.id }}">
    <div class="isc-sg__head">
      <p class="isc-sg__title" id="IscSizeGuide-{{ product.id }}">Guida alle taglie</p>
      <button type="button" class="isc-sg__close" data-isc-size-close aria-label="Chiudi">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5.5 5.5 9 9m0-9-9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </div>
    <table class="isc-sg__table">
      {%- assign head = block.settings.isc_size_head | default: 'Taglia IT | Seno | Vita | Fianchi' | split: '|' -%}
      <thead><tr>{%- for h in head -%}<th scope="col">{{ h | strip | escape }}</th>{%- endfor -%}</tr></thead>
      <tbody>
        {%- for row in rows -%}
          {%- assign r = row | strip -%}
          {%- if r contains '=' -%}
            {%- assign size = r | split: '=' | first | strip -%}
            {%- assign cells = r | remove_first: size | remove_first: '=' | split: '|' -%}
            <tr><td>{{ size | escape }}</td>{%- for c in cells -%}<td>{{ c | strip | escape }}</td>{%- endfor -%}</tr>
          {%- endif -%}
        {%- endfor -%}
      </tbody>
    </table>
    {%- if block.settings.isc_size_tip != blank -%}
      <p class="isc-sg__tip"><span aria-hidden="true">✦</span> {{ block.settings.isc_size_tip | escape }}</p>
    {%- endif -%}
  </dialog>
</isc-size-guide>

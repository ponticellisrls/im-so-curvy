{%- comment -%}
  I'M So Curvy: gradienti condivisi dalle icone "gioiello" (rosa metallizzato, vino e perla).
  Un solo <svg> sempre visibile (0×0) evita problemi con icone dentro elementi nascosti.
{%- endcomment -%}
<svg width="0" height="0" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="iscRose" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fbe4ea"/>
      <stop offset=".34" stop-color="#d98aa3"/>
      <stop offset=".58" stop-color="#f3c6d3"/>
      <stop offset="1" stop-color="#8f3460"/>
    </linearGradient>
    <linearGradient id="iscWine" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#a3406b"/>
      <stop offset=".55" stop-color="#660033"/>
      <stop offset="1" stop-color="#3d0c24"/>
    </linearGradient>
    <linearGradient id="iscPearl" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff"/>
      <stop offset=".4" stop-color="#eadde2"/>
      <stop offset=".65" stop-color="#fbf6f8"/>
      <stop offset="1" stop-color="#b9a2ab"/>
    </linearGradient>
  </defs>
</svg>

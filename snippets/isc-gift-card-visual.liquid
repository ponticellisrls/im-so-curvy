{%- comment -%}
  I'M So Curvy: gift card animata (carta bordeaux + carta rosa metallizzato dietro, riflesso, cappelliera).
  Usata dalla sezione Gift Card della home e dalla pagina prodotto della gift card.
  Accepts:
  - url: {String} link della carta
  - value: {String} importo mostrato all'inizio (es. "€50")
  - label: {String} testo accessibile del link
{%- endcomment -%}
<div class="isc-gc__stage" data-isc-gc-stage>
  <div class="isc-gc__card isc-gc__card--back" aria-hidden="true">
    <span class="isc-gc__back-word">Curvy</span>
  </div>

  <a href="{{ url }}" class="isc-gc__card isc-gc__card--front" aria-label="{{ label | default: 'Gift Card' | escape }}">
    <span class="isc-gc__foil" aria-hidden="true"></span>
    <span class="isc-gc__top">
      <img src="{{ 'isc-logo-white.png' | asset_url }}" alt="I'M So Curvy" width="292" height="200" loading="lazy" class="isc-gc__logo">
      <svg class="isc-gc__chip" viewBox="0 0 40 30" aria-hidden="true">
        <rect x=".75" y=".75" width="38.5" height="28.5" rx="5" fill="url(#IscGcChip)" stroke="rgba(255,255,255,.35)" stroke-width="1.5"/>
        <path d="M20 22s-5-3-5-6.2c0-1.6 1.2-2.8 2.7-2.8 1 0 1.9.6 2.3 1.4.4-.8 1.3-1.4 2.3-1.4 1.5 0 2.7 1.2 2.7 2.8 0 3.2-5 6.2-5 6.2z" fill="#660033"/>
        <defs><linearGradient id="IscGcChip" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fbe4ea"/><stop offset=".5" stop-color="#d98aa3"/><stop offset="1" stop-color="#f6d2dc"/></linearGradient></defs>
      </svg>
    </span>
    <span class="isc-gc__label">Gift <em>Card</em></span>
    <span class="isc-gc__value">
      <span class="isc-gc__value-num" data-isc-gc-value>{{ value }}</span>
    </span>
    <span class="isc-gc__bottom">
      <span>imsocurvy.it</span>
      <span class="isc-gc__dots" aria-hidden="true">✦ ✦ ✦</span>
    </span>
  </a>

  <span class="isc-gc__box" aria-hidden="true">{% render 'isc-gift' %}</span>
  <span class="isc-gc__spark isc-gc__spark--1" aria-hidden="true">✦</span>
  <span class="isc-gc__spark isc-gc__spark--2" aria-hidden="true">✦</span>
  <span class="isc-gc__spark isc-gc__spark--3" aria-hidden="true">✦</span>
</div>

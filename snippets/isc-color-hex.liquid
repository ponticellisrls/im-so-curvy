{%- comment -%}
  I'M So Curvy: colore CSS dal nome del colore (per i pallini dei filtri).
  Accepts:
  - name: {String}
{%- endcomment -%}
{%- liquid
  assign n = name | downcase
  assign c = '#d8d6d0'
  if n contains 'multi'
    assign c = 'conic-gradient(#b3261e, #c9a255, #2f8f5b, #1f2a4a, #b3261e)'
  elsif n contains 'leopard' or n contains 'animal'
    assign c = 'radial-gradient(circle at 30% 30%, #3a2a1a 18%, transparent 20%), radial-gradient(circle at 70% 65%, #3a2a1a 16%, transparent 18%), #c9975a'
  elsif n contains 'nero' or n contains 'black'
    assign c = '#111111'
  elsif n contains 'bianc' or n contains 'white'
    assign c = '#fafafa'
  elsif n contains 'moro'
    assign c = '#3b2a20'
  elsif n contains 'caff'
    assign c = '#4a3226'
  elsif n contains 'cuoio'
    assign c = '#9a5a2e'
  elsif n contains 'marrone' or n contains 'brown'
    assign c = '#5a3f2e'
  elsif n contains 'khaki' or n contains 'kaki'
    assign c = '#7d7457'
  elsif n contains 'taupe' or n contains 'tortora'
    assign c = '#8f7d6b'
  elsif n contains 'beige' or n contains 'sabbia' or n contains 'nude'
    assign c = '#d9c3a5'
  elsif n contains 'crema' or n contains 'panna' or n contains 'avorio'
    assign c = '#efe7da'
  elsif n contains 'cammello' or n contains 'camel'
    assign c = '#b98a5e'
  elsif n contains 'senape' or n contains 'ocra'
    assign c = '#c99a2e'
  elsif n contains 'jeans' or n contains 'denim'
    assign c = '#3e5a7e'
  elsif n contains 'azzurr' or n contains 'celest'
    assign c = '#8fb6d9'
  elsif n contains 'petrolio' or n contains 'ottanio'
    assign c = '#1f5a63'
  elsif n contains 'lilla' or n contains 'lavanda' or n contains 'glicine'
    assign c = '#b9a3cf'
  elsif n contains 'viola' or n contains 'prugna' or n contains 'melanzana'
    assign c = '#5a2d5e'
  elsif n contains 'fucsia' or n contains 'magenta'
    assign c = '#c8267a'
  elsif n contains 'corallo' or n contains 'salmone'
    assign c = '#ef7f6a'
  elsif n contains 'cipria' or n contains 'blush'
    assign c = '#ecc4c4'
  elsif n contains 'bordeaux' or n contains 'wine' or n contains 'vino'
    assign c = '#5e1622'
  elsif n contains 'ross' or n contains 'red'
    assign c = '#b3261e'
  elsif n contains 'rosa' or n contains 'pink'
    assign c = '#e8b4bc'
  elsif n contains 'verde' or n contains 'green'
    assign c = '#3f5b45'
  elsif n contains 'blu' or n contains 'navy'
    assign c = '#1f2a4a'
  elsif n contains 'grigi' or n contains 'grey' or n contains 'gray'
    assign c = '#9a9a96'
  elsif n contains 'oro' or n contains 'gold'
    assign c = 'linear-gradient(135deg, #f6e7b8, #c9a255 55%, #8f6a2a)'
  elsif n contains 'argent' or n contains 'silver'
    assign c = 'linear-gradient(135deg, #fbfbfa, #bfc0bc 55%, #7b7c78)'
  endif
  echo c
-%}

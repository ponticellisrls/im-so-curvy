{%- comment -%}
  I'M So Curvy: "Spazio sopra / sotto" della sezione (su mobile ridotto al 75%).
  Imposta --sec-pt e --sec-pb, usate dal CSS delle sezioni I'M So Curvy.
{%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} {
    --sec-pt: {{ section.settings.padding_top | times: 0.75 | round }}px;
    --sec-pb: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --sec-pt: {{ section.settings.padding_top }}px;
      --sec-pb: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

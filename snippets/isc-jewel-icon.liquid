{%- comment -%}
  I'M So Curvy: icone "gioiello" (rosa metallizzato, vino e perla), nello stile della cappelliera regalo.
  I gradienti sono definiti una volta sola da snippets/isc-jewel-defs.liquid.
  Accepts:
  - name: {String} truck | return | cash | installments | chat | gift | shield | star | lock | calendar | box | heart | hanger
{%- endcomment -%}
<svg class="isc-jewel isc-jewel--{{ name }}" viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false">
  <ellipse class="isc-jewel__shadow" cx="32" cy="58" rx="20" ry="3" fill="#3d0c24" opacity=".28"/>
  {%- case name -%}
    {%- when 'truck' -%}
      <g class="isc-jewel__speed" stroke="url(#iscPearl)" stroke-width="2" stroke-linecap="round">
        <path d="M1 25h5M0 31h6M2 37h4"/>
      </g>
      <g class="isc-jewel__body">
        <path d="M9 21a7 7 0 0 1 7-7h23.5c2.3 0 4.4 1.2 5.6 3.2L49.5 25H53a6 6 0 0 1 6 6v9.5a3.5 3.5 0 0 1-3.5 3.5H9z" fill="url(#iscPearl)"/>
        <path d="M41 18h1.6c.9 0 1.7.5 2.2 1.2L48 25h-7z" fill="url(#iscWine)"/>
        <path d="M9 38h50v2.5a3.5 3.5 0 0 1-3.5 3.5H9z" fill="url(#iscRose)"/>
        <path d="M25 35.5s-7.5-4.4-7.5-9c0-2.3 1.8-4 4-4 1.5 0 2.8.8 3.5 2 .7-1.2 2-2 3.5-2 2.2 0 4 1.7 4 4 0 4.6-7.5 9-7.5 9z" fill="url(#iscRose)"/>
        <path d="M13 17.5c1-1.4 2.3-2 4-2h12" stroke="#fff" stroke-width="1.8" stroke-linecap="round" opacity=".7"/>
      </g>
      <g class="isc-jewel__wheel" style="transform-origin: 20px 45px;">
        <circle cx="20" cy="45" r="6" fill="url(#iscWine)"/>
        <circle cx="20" cy="45" r="2.6" fill="url(#iscRose)"/>
        <path d="M20 40.5v9M15.5 45h9" stroke="#3d0c24" stroke-width="1"/>
      </g>
      <g class="isc-jewel__wheel" style="transform-origin: 48px 45px;">
        <circle cx="48" cy="45" r="6" fill="url(#iscWine)"/>
        <circle cx="48" cy="45" r="2.6" fill="url(#iscRose)"/>
        <path d="M48 40.5v9M43.5 45h9" stroke="#3d0c24" stroke-width="1"/>
      </g>
    {%- when 'return' -%}
      <g class="isc-jewel__arrows" style="transform-origin: 32px 33px;">
        <path d="M13 29a19.5 19.5 0 0 1 32-11.5" stroke="url(#iscRose)" stroke-width="3" stroke-linecap="round"/>
        <path d="M47.5 11.5l-.6 8.4-8.2-1.6z" fill="url(#iscRose)"/>
        <path d="M51 37a19.5 19.5 0 0 1-32 11.5" stroke="url(#iscRose)" stroke-width="3" stroke-linecap="round"/>
        <path d="M16.5 54.5l.6-8.4 8.2 1.6z" fill="url(#iscRose)"/>
      </g>
      <g class="isc-jewel__body">
        <path d="M27 26v-2.5a5 5 0 0 1 10 0V26" stroke="url(#iscWine)" stroke-width="2.4" stroke-linecap="round"/>
        <path d="M21.5 26h21l1.8 17.5a2.8 2.8 0 0 1-2.8 3.1H22.5a2.8 2.8 0 0 1-2.8-3.1z" fill="url(#iscPearl)"/>
        <path d="M21.5 26h21l.4 3.6h-21.8z" fill="#3d0c24" opacity=".1"/>
        <path d="M32 41.5s-4.6-2.7-4.6-5.5c0-1.4 1.1-2.4 2.4-2.4.9 0 1.7.5 2.2 1.2.5-.7 1.3-1.2 2.2-1.2 1.3 0 2.4 1 2.4 2.4 0 2.8-4.6 5.5-4.6 5.5z" fill="url(#iscWine)"/>
      </g>
    {%- when 'cash' -%}
      <g class="isc-jewel__body">
        <rect x="5" y="23" width="38" height="22" rx="3.5" fill="url(#iscPearl)" transform="rotate(-9 24 34)"/>
        <rect x="8" y="27" width="38" height="22" rx="3.5" fill="url(#iscPearl)"/>
        <rect x="11.5" y="30.5" width="31" height="15" rx="2" stroke="#d98aa3" stroke-width="1" fill="none" opacity=".8"/>
        <circle cx="27" cy="38" r="5" fill="url(#iscWine)"/>
        <path d="M29.2 35.6a3 3 0 1 0 0 4.8M24.3 37.2h3.4M24.3 38.9h3.4" stroke="#fbe4ea" stroke-width="1" stroke-linecap="round"/>
      </g>
      <g class="isc-jewel__stack">
        <ellipse cx="51" cy="51" rx="8.5" ry="3" fill="url(#iscWine)"/>
        <rect x="42.5" y="45" width="17" height="6" fill="url(#iscWine)"/>
        <ellipse cx="51" cy="45" rx="8.5" ry="3" fill="url(#iscRose)"/>
        <rect x="42.5" y="39.5" width="17" height="5.5" fill="url(#iscWine)"/>
        <ellipse cx="51" cy="39.5" rx="8.5" ry="3" fill="url(#iscRose)"/>
      </g>
      <g class="isc-jewel__coin">
        <circle cx="51" cy="21" r="7.5" fill="url(#iscRose)"/>
        <path d="M51 25.2s-3.6-2.1-3.6-4.3c0-1.1.9-1.9 1.9-1.9.7 0 1.3.4 1.7.9.4-.5 1-.9 1.7-.9 1 0 1.9.8 1.9 1.9 0 2.2-3.6 4.3-3.6 4.3z" fill="#660033"/>
        <path d="M47.5 17.5l1.6.9" stroke="#fff" stroke-width="1.2" stroke-linecap="round" opacity=".8"/>
      </g>
    {%- when 'installments' -%}
      <g class="isc-jewel__body" style="transform-origin: 28px 36px;">
        <rect x="6" y="21" width="44" height="29" rx="5" fill="url(#iscPearl)" transform="rotate(-7 28 35)"/>
        <g transform="rotate(-7 28 35)">
          <rect x="6" y="27" width="44" height="5" fill="url(#iscWine)"/>
          <rect x="11" y="36" width="9" height="6.5" rx="1.6" fill="url(#iscRose)"/>
          <path d="M25 45h4M32 45h4M39 45h4" stroke="#b9a2ab" stroke-width="1.6" stroke-linecap="round"/>
        </g>
      </g>
      <g class="isc-jewel__badge" style="transform-origin: 48px 17px;">
        <circle cx="48" cy="17" r="11.5" fill="url(#iscWine)"/>
        <path d="M48 17V9a8 8 0 0 1 8 8z" fill="url(#iscRose)"/>
        <path d="M48 17h8a8 8 0 0 1-8 8z" fill="url(#iscRose)"/>
        <path d="M48 17v8a8 8 0 0 1-8-8z" fill="url(#iscRose)"/>
        <path d="M48 17h-8a8 8 0 0 1 8-8z" fill="#fbe4ea" opacity=".35"/>
        <path d="M48 8.5v17M39.5 17h17" stroke="#660033" stroke-width="1.4"/>
      </g>
    {%- when 'chat' -%}
      <g class="isc-jewel__body">
        <path d="M9 29c0-9.4 8.7-17 19.5-17S48 19.6 48 29s-8.7 17-19.5 17c-2.6 0-5.1-.4-7.4-1.2L11.5 50l2.8-8C11 38.8 9 34.1 9 29z" fill="url(#iscPearl)"/>
        <path d="M15 21.5c2.4-3.4 6.6-5.6 11.5-5.9" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".75"/>
      </g>
      <g class="isc-jewel__dots" fill="url(#iscRose)">
        <circle class="isc-jewel__dot" cx="20" cy="29" r="3.2"/>
        <circle class="isc-jewel__dot" cx="28.5" cy="29" r="3.2"/>
        <circle class="isc-jewel__dot" cx="37" cy="29" r="3.2"/>
      </g>
      <g class="isc-jewel__badge" style="transform-origin: 52px 44px;">
        <circle cx="52" cy="44" r="8.5" fill="url(#iscWine)"/>
        <path d="M52 48.3s-4-2.4-4-4.8c0-1.2 1-2.1 2.1-2.1.8 0 1.5.4 1.9 1 .4-.6 1.1-1 1.9-1 1.1 0 2.1.9 2.1 2.1 0 2.4-4 4.8-4 4.8z" fill="url(#iscRose)"/>
      </g>
    {%- when 'gift' -%}
      <g class="isc-jewel__body">
        <path d="M14 30h36v19c0 2.8-8 5-18 5s-18-2.2-18-5z" fill="url(#iscWine)"/>
        <path d="M29.5 30h5v24c-.8.1-1.6.1-2.5.1s-1.7 0-2.5-.1z" fill="url(#iscRose)"/>
        <path d="M17 34v12" stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".3"/>
      </g>
      <g class="isc-jewel__badge" style="transform-origin: 14px 28px;">
        <path d="M12.5 26.5c0-3 8.7-5.5 19.5-5.5s19.5 2.5 19.5 5.5v3.5c0 3-8.7 5.5-19.5 5.5s-19.5-2.5-19.5-5.5z" fill="url(#iscRose)"/>
        <ellipse cx="32" cy="26.5" rx="19.5" ry="5.5" fill="#fbe4ea"/>
        <path d="M32 24.5c-4.5-7-13-8-13-3 0 3.2 6.5 3.8 13 3zM32 24.5c4.5-7 13-8 13-3 0 3.2-6.5 3.8-13 3z" fill="url(#iscWine)"/>
        <circle cx="32" cy="24.2" r="2.3" fill="url(#iscRose)"/>
      </g>
    {%- when 'shield' -%}
      <g class="isc-jewel__body">
        <path d="M32 6c6.2 3.4 12.6 5.2 19 5.6v15C51 40 43 50.2 32 55 21 50.2 13 40 13 26.6v-15C19.4 11.2 25.8 9.4 32 6z" fill="url(#iscPearl)"/>
        <path d="M32 11.5c4.6 2.4 9.4 3.8 14 4.3v10.9c0 9.8-5.6 17.7-14 21.8z" fill="url(#iscRose)" opacity=".9"/>
      </g>
      <path class="isc-jewel__badge" d="M32 40s-9-5.3-9-10.8c0-2.7 2.1-4.7 4.6-4.7 1.8 0 3.4 1 4.4 2.4 1-1.4 2.6-2.4 4.4-2.4 2.5 0 4.6 2 4.6 4.7C41 34.7 32 40 32 40z" fill="url(#iscWine)"/>
    {%- when 'star' -%}
      <g class="isc-jewel__body" style="transform-origin: 30px 28px;">
        <path d="M30 5c1.9 11.6 6.4 16.1 18 18-11.6 1.9-16.1 6.4-18 18-1.9-11.6-6.4-16.1-18-18 11.6-1.9 16.1-6.4 18-18z" fill="url(#iscRose)"/>
        <path d="M30 5c1 6 2.6 10 5.4 12.6L30 23z" fill="#fff" opacity=".45"/>
      </g>
      <path class="isc-jewel__badge" style="transform-origin: 48px 44px;" d="M48 36c.9 5.4 2.6 7.1 8 8-5.4.9-7.1 2.6-8 8-.9-5.4-2.6-7.1-8-8 5.4-.9 7.1-2.6 8-8z" fill="url(#iscWine)"/>
    {%- when 'calendar' -%}
      <g class="isc-jewel__body">
        <rect x="9" y="14" width="46" height="40" rx="8" fill="url(#iscPearl)"/>
        <path d="M9 22a8 8 0 0 1 8-8h30a8 8 0 0 1 8 8v4H9z" fill="url(#iscWine)"/>
        <g fill="#d9b8c3">
          <circle cx="18" cy="34" r="2.6"/><circle cx="27" cy="34" r="2.6"/><circle cx="36" cy="34" r="2.6"/>
          <circle cx="18" cy="43" r="2.6"/><circle cx="27" cy="43" r="2.6"/>
        </g>
        <circle cx="21" cy="11" r="3.4" fill="url(#iscRose)"/>
        <circle cx="43" cy="11" r="3.4" fill="url(#iscRose)"/>
      </g>
      <g class="isc-jewel__badge" style="transform-origin: 46px 46px;">
        <circle cx="46" cy="46" r="10" fill="url(#iscRose)"/>
        <path d="M46 51s-5-3-5-6c0-1.5 1.2-2.6 2.6-2.6 1 0 1.9.5 2.4 1.3.5-.8 1.4-1.3 2.4-1.3 1.4 0 2.6 1.1 2.6 2.6 0 3-5 6-5 6z" fill="#660033"/>
      </g>
    {%- when 'box' -%}
      <g class="isc-jewel__spark" style="transform-origin: 32px 12px;">
        <path d="M32 4c.6 3.6 1.8 4.8 5.4 5.4-3.6.6-4.8 1.8-5.4 5.4-.6-3.6-1.8-4.8-5.4-5.4 3.6-.6 4.8-1.8 5.4-5.4z" fill="url(#iscRose)"/>
        <circle cx="43" cy="9" r="1.4" fill="url(#iscRose)"/>
        <circle cx="21" cy="12" r="1.1" fill="url(#iscPearl)"/>
      </g>
      <path d="M25 29v-6.5a7 7 0 0 1 14 0V29" stroke="url(#iscWine)" stroke-width="2.6" stroke-linecap="round"/>
      <g class="isc-jewel__flap isc-jewel__flap--l" style="transform-origin: 24px 28px;">
        <path d="M33 28H16l1.5-10.5z" fill="url(#iscPearl)"/>
      </g>
      <g class="isc-jewel__flap isc-jewel__flap--r" style="transform-origin: 40px 28px;">
        <path d="M31 28h17l-3-11.5z" fill="#fbe4ea"/>
      </g>
      <g class="isc-jewel__body">
        <path d="M14.5 27h35l-2.4 24.6a3 3 0 0 1-3 2.7H19.9a3 3 0 0 1-3-2.7z" fill="url(#iscRose)"/>
        <path d="M14.5 27h35l-.3 3.4H14.8z" fill="#3d0c24" opacity=".12"/>
        <rect x="22" y="37" width="20" height="9" rx="1.5" fill="#fff" opacity=".88"/>
        <path d="M32 44.2s-2.8-1.6-2.8-3.3c0-.8.6-1.5 1.5-1.5.5 0 1 .3 1.3.7.3-.4.8-.7 1.3-.7.9 0 1.5.7 1.5 1.5 0 1.7-2.8 3.3-2.8 3.3z" fill="#660033"/>
      </g>
    {%- when 'lock' -%}
      <g class="isc-jewel__badge" style="transform-origin: 32px 26px;">
        <path d="M22 28v-6a10 10 0 0 1 20 0v6" stroke="url(#iscPearl)" stroke-width="5" stroke-linecap="round"/>
      </g>
      <g class="isc-jewel__body">
        <rect x="15" y="26" width="34" height="27" rx="8" fill="url(#iscRose)"/>
        <path d="M32 46s-6-3.5-6-7.2c0-1.8 1.4-3.2 3.1-3.2 1.2 0 2.3.7 2.9 1.6.6-.9 1.7-1.6 2.9-1.6 1.7 0 3.1 1.4 3.1 3.2 0 3.7-6 7.2-6 7.2z" fill="url(#iscWine)"/>
        <path d="M19 31c1-1.5 2.4-2 4-2h6" stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".6"/>
      </g>
    {%- when 'heart' -%}
      <g class="isc-jewel__body" style="transform-origin: 32px 32px;">
        <path d="M32 53S9 39.6 9 23.6C9 16.6 14.5 11 21.3 11c4.4 0 8.2 2.3 10.7 5.7C34.5 13.3 38.3 11 42.7 11 49.5 11 55 16.6 55 23.6 55 39.6 32 53 32 53z" fill="url(#iscRose)"/>
        <path d="M32 53S9 39.6 9 23.6c0-2.4.6-4.6 1.8-6.5C14 30 26 41 32 45z" fill="url(#iscWine)" opacity=".55"/>
        <path d="M15 20c1-3 3.6-4.8 6.6-4.8" stroke="#fff" stroke-width="2.4" stroke-linecap="round" opacity=".8"/>
      </g>
      <path class="isc-jewel__badge" style="transform-origin: 50px 12px;" d="M50 6c.6 3.6 1.8 4.8 5.4 5.4-3.6.6-4.8 1.8-5.4 5.4-.6-3.6-1.8-4.8-5.4-5.4 3.6-.6 4.8-1.8 5.4-5.4z" fill="url(#iscPearl)"/>
    {%- else -%}
      <g class="isc-jewel__body">
        <path d="M32 18.5v-2.2c0-1.7 1.6-2.6 2.8-3.4a4.6 4.6 0 1 0-7.2-3.8" stroke="url(#iscPearl)" stroke-width="3" stroke-linecap="round"/>
        <path d="M32 19L8.5 38.2c-2.3 1.9-1 5.3 1.9 5.3h43.2c2.9 0 4.2-3.4 1.9-5.3z" stroke="url(#iscRose)" stroke-width="3.4" stroke-linejoin="round"/>
        <path d="M14 43.5h36" stroke="url(#iscWine)" stroke-width="3.4" stroke-linecap="round"/>
      </g>
  {%- endcase -%}
</svg>

{%- comment -%}
  I'M So Curvy: galleria a schermo intero. Si apre cliccando una foto del prodotto.
  Foto grandi quanto lo schermo. Desktop: un clic ingrandisce (moderatamente) nel punto scelto,
  poi si trascina per spostarsi. Telefono: si ingrandisce con due dita (zoom nativo). Scorri o frecce per cambiare foto, Esc o X per chiudere.
  Accepts:
  - product: {Object}
  - section: {Object}
{%- endcomment -%}
{%- assign images = product.media | where: 'media_type', 'image' -%}
{%- if images.size > 0 -%}
  <isc-lightbox class="isc-lb" data-section="{{ section.id }}">
    <dialog class="isc-lb__dialog" aria-label="Foto di {{ product.title | escape }}">
      <div class="isc-lb__track" data-isc-lb-track>
        {%- for media in images -%}
          <figure class="isc-lb__slide" data-media-id="{{ media.id }}">
            <div class="isc-lb__zoom" data-isc-lb-zoom>
              {{
                media
                | image_url: width: 2400
                | image_tag:
                  loading: 'lazy',
                  widths: '800, 1200, 1600, 2000, 2400',
                  sizes: '100vw',
                  alt: media.alt,
                  class: 'isc-lb__img',
                  draggable: 'false'
              }}
            </div>
          </figure>
        {%- endfor -%}
      </div>

      <div class="isc-lb__bar">
        <span class="isc-lb__count"><span data-isc-lb-current>1</span> / {{ images.size }}</span>
        <span class="isc-lb__hint" data-isc-lb-hint>Tocca per ingrandire</span>
        <button type="button" class="isc-lb__close" data-isc-lb-close aria-label="Chiudi">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5.5 5.5 9 9m0-9-9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
      </div>
      {%- if images.size > 1 -%}
        <button type="button" class="isc-lb__nav isc-lb__nav--prev" data-isc-lb-prev aria-label="Foto precedente">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.5 4.5 7.3 9.3a1 1 0 0 0 0 1.4l5.2 4.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <button type="button" class="isc-lb__nav isc-lb__nav--next" data-isc-lb-next aria-label="Foto successiva">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m7.5 4.5 5.2 4.8a1 1 0 0 1 0 1.4l-5.2 4.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
      {%- endif -%}
    </dialog>
  </isc-lightbox>
{%- endif -%}

{%- comment -%}
  I'M So Curvy: icone a linea (24×24), tratti morbidi con dettagli a cuore.
  Ogni tratto ha pathLength="1" per l'animazione "disegno".
  Accepts:
  - name: {String}
{%- endcomment -%}
<svg class="isc-icon isc-icon--{{ name }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'truck' -%}
      <path pathLength="1" d="M2.5 15.5V8.5a2.5 2.5 0 0 1 2.5-2.5h9v9.5"/>
      <path pathLength="1" d="M14 9h3.4c.7 0 1.4.4 1.7 1l1.9 3.1v2.4H14"/>
      <path pathLength="1" d="M2.5 15.5h2.7M8.8 15.5h6.6"/>
      <circle pathLength="1" cx="7" cy="16.8" r="1.8"/>
      <circle pathLength="1" cx="17.2" cy="16.8" r="1.8"/>
      <path pathLength="1" d="M8.2 12.8s-2.3-1.3-2.3-2.8c0-.7.5-1.2 1.2-1.2.5 0 .9.3 1.1.7.2-.4.6-.7 1.1-.7.7 0 1.2.5 1.2 1.2 0 1.5-2.3 2.8-2.3 2.8z"/>
    {%- when 'return' -%}
      <path pathLength="1" d="M6.2 8.5h11.6l-.9 10.3a1.5 1.5 0 0 1-1.5 1.4H8.6a1.5 1.5 0 0 1-1.5-1.4z"/>
      <path pathLength="1" d="M9.5 8.5V7a2.5 2.5 0 0 1 5 0v1.5"/>
      <path pathLength="1" d="M14.2 14.8H10m0 0l1.6-1.6M10 14.8l1.6 1.6"/>
    {%- when 'cash' -%}
      <path pathLength="1" d="M4.5 7h15A1.5 1.5 0 0 1 21 8.5v7a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 15.5v-7A1.5 1.5 0 0 1 4.5 7z"/>
      <path pathLength="1" d="M13.8 10.3a2.6 2.6 0 1 0 0 3.4M9.6 11.4h3M9.6 12.6h3"/>
      <path pathLength="1" d="M5.8 9.8v.01M18.2 14.2v.01"/>
    {%- when 'installments' -%}
      <path pathLength="1" d="M19.8 13.5A8 8 0 1 1 10.5 4.2"/>
      <path pathLength="1" d="M12 12V4M12 12l5.6 5.6"/>
      <path pathLength="1" d="M14 2.6a7.6 7.6 0 0 1 7.4 7.4H14z"/>
    {%- when 'lock' -%}
      <path pathLength="1" d="M8.5 10.5h7a3 3 0 0 1 3 3v4a3 3 0 0 1-3 3h-7a3 3 0 0 1-3-3v-4a3 3 0 0 1 3-3z"/>
      <path pathLength="1" d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/>
      <path pathLength="1" d="M12 17.6s-2-1.2-2-2.5c0-.6.5-1.1 1.1-1.1.4 0 .7.2.9.5.2-.3.5-.5.9-.5.6 0 1.1.5 1.1 1.1 0 1.3-2 2.5-2 2.5z"/>
    {%- when 'chat' -%}
      <path pathLength="1" d="M12 4.5c4.7 0 8.5 3.1 8.5 7s-3.8 7-8.5 7c-1 0-2-.1-2.9-.4L5 19.5l1.2-3.4c-1.7-1.2-2.7-2.8-2.7-4.6 0-3.9 3.8-7 8.5-7z"/>
      <path pathLength="1" d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01"/>
    {%- when 'shield' -%}
      <path pathLength="1" d="M12 3.5c2.2 1.2 4.5 1.9 7 2.1v5.6c0 4.6-3 8-7 9.3-4-1.3-7-4.7-7-9.3V5.6c2.5-.2 4.8-.9 7-2.1z"/>
      <path pathLength="1" d="M12 15.2s-3-1.8-3-3.7c0-.9.7-1.6 1.6-1.6.6 0 1.1.3 1.4.8.3-.5.8-.8 1.4-.8.9 0 1.6.7 1.6 1.6 0 1.9-3 3.7-3 3.7z"/>
    {%- when 'gift' -%}
      <path pathLength="1" d="M4.5 10c0 1.1 3.4 2 7.5 2s7.5-.9 7.5-2-3.4-2-7.5-2-7.5.9-7.5 2z"/>
      <path pathLength="1" d="M4.5 10v8c0 1.1 3.4 2 7.5 2s7.5-.9 7.5-2v-8"/>
      <path pathLength="1" d="M12 12v8"/>
      <path pathLength="1" d="M12 8c-1.6-2.7-4.8-3-4.8-1.2 0 1.1 2 1.4 4.8 1.2zM12 8c1.6-2.7 4.8-3 4.8-1.2 0 1.1-2 1.4-4.8 1.2z"/>
    {%- when 'star' -%}
      <path pathLength="1" d="M11 3.5c.8 4.6 2.4 6.2 7 7-4.6.8-6.2 2.4-7 7-.8-4.6-2.4-6.2-7-7 4.6-.8 6.2-2.4 7-7z"/>
      <path pathLength="1" d="M18.5 15.5v4M16.5 17.5h4"/>
    {%- when 'heart' -%}
      <path pathLength="1" d="M12 19.5s-7.5-4.4-7.5-9.6c0-2.4 1.9-4.4 4.3-4.4 1.4 0 2.5.7 3.2 1.8.7-1.1 1.8-1.8 3.2-1.8 2.4 0 4.3 2 4.3 4.4 0 5.2-7.5 9.6-7.5 9.6z"/>
    {%- when 'hanger', 'shoe' -%}
      <path pathLength="1" d="M12 8.2V7.4c0-.8.7-1.2 1.3-1.6a2 2 0 1 0-3.1-1.7"/>
      <path pathLength="1" d="M12 8.2l-8.6 7.1c-.9.7-.4 2.2.8 2.2h15.6c1.2 0 1.7-1.5.8-2.2z"/>
      <path pathLength="1" d="M7 20h10"/>
    {%- when 'pin' -%}
      <path pathLength="1" d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/>
      <path pathLength="1" d="M12 12.6s-2.3-1.4-2.3-2.9c0-.7.5-1.2 1.2-1.2.5 0 .9.3 1.1.7.2-.4.6-.7 1.1-.7.7 0 1.2.5 1.2 1.2 0 1.5-2.3 2.9-2.3 2.9z"/>
    {%- when 'mail' -%}
      <path pathLength="1" d="M5.5 6.5h13a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z"/>
      <path pathLength="1" d="M4 7.5l8 5.5 8-5.5"/>
    {%- when 'clock' -%}
      <circle pathLength="1" cx="12" cy="12" r="8.5"/>
      <path pathLength="1" d="M12 7.5V12l3 2"/>
      <path pathLength="1" d="M12 3.5v1M20.5 12h-1M12 20.5v-1M3.5 12h1"/>
    {%- when 'whatsapp' -%}
      <path pathLength="1" d="M4.5 19.5l1.2-3.8A8 8 0 1 1 9 19z"/>
      <path pathLength="1" d="M9.2 8.6c.2-.5.6-.6 1-.6l.6 1.5-.6.8c.5 1 1.3 1.8 2.3 2.3l.8-.6 1.5.6c0 .4-.1.8-.6 1-1.8.8-5.8-3.2-5-5z"/>
    {%- when 'phone' -%}
      <path pathLength="1" d="M6.5 3.5h3l1.5 4-2 1.3a10 10 0 0 0 6.2 6.2l1.3-2 4 1.5v3c0 1.1-.9 2-2 2A15.5 15.5 0 0 1 4.5 5.5c0-1.1.9-2 2-2z"/>
    {%- else -%}
      <path pathLength="1" d="M12 19.5s-7.5-4.4-7.5-9.6c0-2.4 1.9-4.4 4.3-4.4 1.4 0 2.5.7 3.2 1.8.7-1.1 1.8-1.8 3.2-1.8 2.4 0 4.3 2 4.3 4.4 0 5.2-7.5 9.6-7.5 9.6z"/>
  {%- endcase -%}
</svg>

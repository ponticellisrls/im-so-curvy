{%- liquid
  assign s = section.settings

  assign pos = s.content_position | split: '-'
  assign pos_v = pos[0]
  assign pos_h = pos[1]
  case pos_v
    when 'top'
      assign v = 'flex-start'
    when 'bottom'
      assign v = 'flex-end'
    else
      assign v = 'center'
  endcase
  case pos_h
    when 'left'
      assign h = 'flex-start'
    when 'right'
      assign h = 'flex-end'
    else
      assign h = 'center'
  endcase
  case s.content_position_mobile
    when 'top'
      assign v_m = 'flex-start'
    when 'bottom'
      assign v_m = 'flex-end'
    else
      assign v_m = 'center'
  endcase

  case s.text_color_mode
    when 'dark'
      assign text_color = '#111111'
    when 'custom'
      assign text_color = s.text_color
    else
      assign text_color = '#ffffff'
  endcase

  case s.text_align
    when 'center'
      assign self = 'center'
    when 'right'
      assign self = 'flex-end'
    else
      assign self = 'flex-start'
  endcase
  case s.text_align_mobile
    when 'center'
      assign self_m = 'center'
    when 'right'
      assign self_m = 'flex-end'
    else
      assign self_m = 'flex-start'
  endcase

  assign overlay_opacity = s.overlay_opacity | divided_by: 100.0
  assign box_opacity = s.box_opacity | divided_by: 100.0

  assign image = s.image
  assign focal = 'center'
  if s.image_position == 'auto'
    if image.presentation.focal_point != blank
      assign focal = image.presentation.focal_point
    endif
  else
    assign focal = s.image_position | replace: '-', ' '
  endif
  assign focal_mobile = focal
  if s.image_mobile != blank and s.image_mobile.presentation.focal_point != blank and s.image_position == 'auto'
    assign focal_mobile = s.image_mobile.presentation.focal_point
  endif

  assign is_split = false
  if s.layout == 'split' or s.layout == 'split_left'
    assign is_split = true
  endif

  assign heading_class = 'isc-hero__heading'
  if s.heading_font == 'regular'
    assign heading_class = heading_class | append: ' isc-hero__heading--regular'
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .isc-hero {
    --hero-v: {{ v }};
    --hero-h: {{ h }};
    --hero-v-m: {{ v_m }};
    --hero-align: {{ s.text_align }};
    --hero-align-m: {{ s.text_align_mobile }};
    --hero-self: {{ self }};
    --hero-self-m: {{ self_m }};
    --hero-text: {{ text_color }};
    --hero-overlay: {{ s.overlay_color }};
    --hero-overlay-opacity: {{ overlay_opacity }};
    --hero-box: {{ s.box_color }};
    --hero-box-opacity: {{ box_opacity }};
    --hero-content-width: {{ s.content_width }}px;
    --hero-heading: {{ s.heading_size }}px;
    --hero-heading-m: {{ s.heading_size_mobile }}px;
    --hero-text-size: {{ s.text_size }}px;
    --hero-focal: {{ focal }};
    --hero-focal-m: {{ focal_mobile }};
    {%- if image != blank and s.height == 'image' %}
      --hero-ratio: {{ image.aspect_ratio }};
    {%- endif %}
    {%- if s.image_mobile != blank and s.height_mobile == 'image' %}
      --hero-ratio-m: {{ s.image_mobile.aspect_ratio }};
    {%- elsif image != blank and s.height_mobile == 'image' %}
      --hero-ratio-m: {{ image.aspect_ratio }};
    {%- endif %}
  }
{%- endstyle -%}

<section
  class="isc-hero isc-hero--{{ s.layout }} isc-hero--h-{{ s.height }} isc-hero--hm-{{ s.height_mobile }} isc-hero--mobile-{{ s.mobile_layout }} isc-hero--overlay-{{ s.overlay_style }} isc-hero--box-{{ s.content_box }} isc-hero--anim-{{ s.image_animation }}{% if s.text_shadow %} isc-hero--shadow{% endif %}{% if s.content_animation %} isc-hero--reveal{% endif %} isc-hero--buttons-full color-{{ s.color_scheme }}"
>
  <div class="isc-hero__media">
    {%- if s.video != blank -%}
      {{
        s.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false,
          image_size: '1920x',
          class: 'isc-hero__video'
      }}
    {%- elsif image != blank -%}
      <picture>
        {%- if s.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ s.image_mobile | image_url: width: 750 }} 750w, {{ s.image_mobile | image_url: width: 1100 }} 1100w, {{ s.image_mobile | image_url: width: 1500 }} 1500w"
            sizes="100vw"
          >
        {%- endif -%}
        {%- if is_split -%}
          {%- assign sizes = '(min-width: 990px) 50vw, 100vw' -%}
        {%- else -%}
          {%- assign sizes = '100vw' -%}
        {%- endif -%}
        {{
          image
          | image_url: width: 3000
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: sizes,
            widths: '750, 1100, 1500, 1920, 2400, 3000',
            alt: image.alt
        }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
    <span class="isc-hero__overlay" aria-hidden="true"></span>
  </div>

  <div class="isc-hero__inner">
    <div class="isc-hero__content">
      {%- if s.eyebrow != blank -%}
        <p class="isc-hero__eyebrow isc-hero__eyebrow--{{ s.eyebrow_style }}">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h1 class="{{ heading_class }}">{{ s.heading }}</h1>
      {%- endif -%}
      {%- if s.text != blank -%}
        <p class="isc-hero__text">{{ s.text | escape | newline_to_br }}</p>
      {%- endif -%}
      {%- if s.button_label_1 != blank or s.button_label_2 != blank -%}
        <div class="isc-hero__buttons">
          {%- if s.button_label_1 != blank -%}
            <a href="{{ s.button_link_1 | default: routes.all_products_collection_url }}" class="isc-btn isc-btn--{{ s.button_style_1 }}">
              {{- s.button_label_1 | escape -}}
            </a>
          {%- endif -%}
          {%- if s.button_label_2 != blank -%}
            <a href="{{ s.button_link_2 | default: routes.collections_url }}" class="isc-btn isc-btn--{{ s.button_style_2 }}">
              {{- s.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if s.banner_link != blank -%}
    <a href="{{ s.banner_link }}" class="isc-hero__link" tabindex="-1" aria-hidden="true"></a>
  {%- endif -%}
</section>


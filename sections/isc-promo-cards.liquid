{%- liquid
  assign s = section.settings
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .isc-promos {
    --promo-pad-top: {{ s.padding_top | times: 0.75 | round }}px;
    --promo-pad-bottom: {{ s.padding_bottom | times: 0.75 | round }}px;
    --promo-cols: {{ s.columns }};
    --promo-ratio: {{ s.ratio }};
    --promo-shade: {{ s.overlay | divided_by: 100.0 }};
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .isc-promos {
      --promo-pad-top: {{ s.padding_top }}px;
      --promo-pad-bottom: {{ s.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="isc-promos isc-promos--m-{{ s.mobile_layout }}{% unless s.mobile_text %} isc-promos--m-notext{% endunless %} color-{{ s.color_scheme }}">
  <div class="isc-container">
    {%- if s.heading != blank -%}
      <div class="isc-section__head">
        <h2 class="isc-h2 isc-pc__heading--accent">{{ s.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <ul class="isc-promos__grid list-unstyled" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign link = b.link | default: routes.collections_url

          comment
            Foto: quella scelta, altrimenti un prodotto della collezione collegata, altrimenti la demo.
          endcomment
          assign photo = b.image
          if photo == blank and b.collection != blank
            assign idx = b.product_index | minus: 1
            for p in b.collection.products offset: idx limit: 1
              assign photo = p.featured_media.preview_image
            endfor
          endif

          assign tone = 'dark'
          case b.palette
            when 'silver'
              assign tone = 'light'
            when 'gold'
              assign tone = 'light'
            when 'white'
              assign tone = 'light'
            when 'sand'
              assign tone = 'light'
          endcase
          assign g1 = b.color_1
          assign g2 = b.color_2
          if b.palette == 'custom' and b.custom_text == 'dark'
            assign tone = 'light'
          endif
        -%}
        <li
          class="isc-promo isc-promo--{{ b.style }} isc-promo--pal-{{ b.palette }} isc-promo--tone-{{ tone }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          style="--g1: {{ g1 }}; --g2: {{ g2 }}; --promo-focal: {{ b.image_position }};"
          {{ block.shopify_attributes }}
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
          {% endif %}
        >
          <a href="{{ link }}" class="isc-promo__overlay-link" aria-label="{{ b.heading | strip_html | escape }}"></a>

          <div class="isc-promo__bg" aria-hidden="true">
            {%- if b.style == 'graphic' -%}
              <span class="isc-promo__sheen"></span>
              {%- if b.graphic_text != blank -%}
                <span class="isc-promo__watermark">{{ b.graphic_text | escape }}</span>
              {%- endif -%}
              <span class="isc-promo__spark isc-promo__spark--1">✦</span>
              <span class="isc-promo__spark isc-promo__spark--2">✦</span>
              <span class="isc-promo__spark isc-promo__spark--3">✦</span>
              {%- if b.icon == 'gift' and b.image == blank -%}
                <span class="isc-promo__shoe isc-promo__shoe--gift">{% render 'isc-gift' %}</span>
              {%- elsif b.image != blank -%}
                <span class="isc-promo__shoe{% if b.image_blend %} isc-promo__shoe--blend{% endif %}">
                  {{ b.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 16vw, 40vw', widths: '300, 500, 800', alt: '' }}
                </span>
              {%- elsif b.demo_image != blank -%}
                <span class="isc-promo__shoe">
                  <img src="{{ b.demo_image | asset_url }}" alt="" loading="lazy" width="900" height="600">
                </span>
              {%- endif -%}
            {%- elsif photo != blank -%}
              {{
                photo
                | image_url: width: 900
                | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '360, 540, 720, 900', alt: '', class: 'isc-promo__img'
              }}
            {%- elsif b.demo_image != blank -%}
              <img src="{{ b.demo_image | asset_url }}" alt="" loading="lazy" width="1256" height="1256" class="isc-promo__img">
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg isc-promo__img' }}
            {%- endif -%}
          </div>

          <div class="isc-promo__content">
            {%- if b.eyebrow != blank -%}
              <p class="isc-promo__eyebrow">{{ b.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if b.heading != blank -%}
              <h3 class="isc-promo__heading">{{ b.heading }}</h3>
            {%- endif -%}
            {%- if b.text != blank -%}
              <p class="isc-promo__text">{{ b.text | escape }}</p>
            {%- endif -%}

            {%- if b.countdown_end != blank -%}
              <p class="isc-promo__countdown" data-isc-countdown="{{ b.countdown_end | escape }}" hidden>
                {%- if b.countdown_label != blank -%}<span>{{ b.countdown_label | escape }}</span>{%- endif -%}
                <strong data-isc-countdown-value></strong>
              </p>
            {%- endif -%}

            {%- if b.button_label != blank -%}
              <a href="{{ link }}" class="isc-promo__btn isc-promo__btn--{{ b.button_style }}">
                {{- b.button_label | escape -}}
                <svg viewBox="0 0 20 10" fill="none" aria-hidden="true"><path d="M.5 5h17M13.2 1.3c.7 1.9 2.3 3.2 4.3 3.7-2 .5-3.6 1.8-4.3 3.7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            {%- endif -%}

            {%- if b.note != blank -%}
              <p class="isc-promo__note">{{ b.note | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<script>
  (function () {
    function fmt(ms) {
      var d = Math.floor(ms / 864e5), h = Math.floor((ms % 864e5) / 36e5), m = Math.floor((ms % 36e5) / 6e4), s = Math.floor((ms % 6e4) / 1e3);
      var pad = function (n) { return String(n).padStart(2, '0'); };
      return (d > 0 ? d + 'g ' : '') + pad(h) + 'h ' + pad(m) + 'm ' + pad(s) + 's';
    }
    document.querySelectorAll('[data-isc-countdown]:not([data-ready])').forEach(function (el) {
      el.dataset.ready = '1';
      var end = new Date(el.dataset.iscCountdown.replace(' ', 'T'));
      var out = el.querySelector('[data-isc-countdown-value]');
      if (isNaN(end)) return;
      function tick() {
        var ms = end - new Date();
        if (ms <= 0) { el.hidden = true; clearInterval(timer); return; }
        out.textContent = fmt(ms);
        el.hidden = false;
      }
      var timer = setInterval(tick, 1000);
      tick();
    });
  })();
</script>


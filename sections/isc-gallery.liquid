{% render 'isc-section-spacing' %}
<section class="isc-section isc-section--last color-{{ section.settings.color_scheme }}">
  <div class="isc-container">
    <div class="isc-section__head">
      <h2 class="isc-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a
          href="{{ section.settings.link | default: settings.social_instagram_link }}"
          class="isc-link"
          {% if section.settings.link contains 'http' or section.settings.link == blank %}
            target="_blank" rel="noopener"
          {% endif %}
        >
          {{- section.settings.link_label | escape -}}
        </a>
      {%- endif -%}
    </div>
    <div class="isc-gallery__grid">
      {%- for block in section.blocks -%}
        <div class="isc-gallery__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
            {{
              block.settings.image
              | image_url: width: 700
              | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 20vw, 50vw', widths: '300, 450, 700', alt: block.settings.image.alt
            }}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          {%- elsif block.settings.demo_image != blank -%}
            <img src="{{ block.settings.demo_image | asset_url }}" alt="" loading="lazy" width="1600" height="2000">
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ISC: galleria social",
  "tag": "div",
  "class": "section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Indossate da voi"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Testo link",
      "default": "@imsocurvy"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Se vuoto porta al profilo Instagram impostato nel tema."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spazi"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Spazio sopra",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Spazio sotto",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Foto",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Immagine"
        },
        {
          "type": "text",
          "id": "demo_image",
          "label": "Immagine demo (file del tema)",
          "info": "Usata solo se non scegli un'immagine sopra."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ISC: galleria social",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}

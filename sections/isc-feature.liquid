{% render 'isc-section-spacing' %}
<section class="isc-section">
  <div class="isc-container">
    <div class="isc-feature color-{{ section.settings.color_scheme }}">
      <div class="isc-feature__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="isc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="isc-feature__heading">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="isc-feature__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.collections_url }}" class="isc-btn isc-btn--outline">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
      <div class="isc-feature__media">
        {%- for img in (1..2) -%}
          {%- if img == 1 -%}{%- assign image = section.settings.image_1 -%}{%- assign demo = section.settings.demo_image_1 -%}{%- else -%}{%- assign image = section.settings.image_2 -%}{%- assign demo = section.settings.demo_image_2 -%}{%- endif -%}
          <div class="isc-feature__img">
            {%- if image != blank -%}
              {{
                image
                | image_url: width: 1000
                | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '375, 550, 750, 1000', alt: image.alt
              }}
            {%- elsif demo != blank -%}
              <img src="{{ demo | asset_url }}" alt="" loading="lazy" width="1600" height="2000">
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ISC: collezione top",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etichetta",
      "default": "Nuova linea"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Collezione Retrò"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Testo",
      "default": "Tessuto morbido, linee che accarezzano le forme e vestibilità studiata per le curve."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Pulsante: testo",
      "default": "Scopri la collezione"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Pulsante: link"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Immagine 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Immagine 2"
    },
    {
      "type": "text",
      "id": "demo_image_1",
      "label": "Immagine demo 1 (file del tema)",
      "info": "Usata solo se non scegli un'immagine sopra."
    },
    {
      "type": "text",
      "id": "demo_image_2",
      "label": "Immagine demo 2 (file del tema)",
      "info": "Usata solo se non scegli un'immagine sopra."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Spazi"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Spazio sopra",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Spazio sotto",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "ISC: collezione top"
    }
  ]
}
{% endschema %}

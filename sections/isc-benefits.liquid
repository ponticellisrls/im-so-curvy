{% render 'isc-section-spacing' %}
{%- assign s = section.settings -%}

<isc-benefits
  class="isc-benefits isc-benefits--icons-{{ s.icon_style }} isc-benefits--{{ s.style }} isc-benefits--ring-{{ s.ring }} isc-benefits--m-{{ s.mobile_layout }}"
  style="--ben-speed: {{ s.speed }}s;"
>
  <div class="isc-container">
    {%- if s.heading != blank -%}
      <h2 class="isc-h2 isc-benefits__heading">{{ s.heading | escape }}</h2>
    {%- endif -%}

    {%- capture items -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign tag = 'div'
          if b.link != blank
            assign tag = 'a'
          endif
        -%}
        <{{ tag }}
          class="isc-benefit"
          {% if b.link != blank %}href="{{ b.link }}"{% endif %}
          style="--i: {{ forloop.index0 }};"
          {{ block.shopify_attributes }}
        >
          <span class="isc-benefit__icon">
            {%- if b.custom_icon != blank -%}
              {{ b.custom_icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', width: 48, height: 48 }}
            {%- elsif s.icon_style == 'jewel' -%}
              {% render 'isc-jewel-icon', name: b.icon %}
            {%- else -%}
              {% render 'isc-icon', name: b.icon %}
            {%- endif -%}
          </span>
          <span class="isc-benefit__copy">
            <span class="isc-benefit__title">{{ b.title | escape }}</span>
            {%- if b.text != blank -%}
              <span class="isc-benefit__text">{{ b.text | escape }}</span>
            {%- endif -%}
          </span>
        </{{ tag }}>
      {%- endfor -%}
    {%- endcapture -%}

    <div class="isc-benefits__row">{{ items }}</div>

    {%- comment -%} Mobile: nastro che scorre (copia per il loop continuo) {%- endcomment -%}
    <div class="isc-benefits__marquee" aria-hidden="true">
      <div class="isc-benefits__track">{{ items | replace: 'shopify-editor-block', 'x-block' | replace: '<a ', '<a tabindex="-1" ' }}</div>
      <div class="isc-benefits__track">{{ items | replace: 'shopify-editor-block', 'x-block' | replace: '<a ', '<a tabindex="-1" ' }}</div>
    </div>
  </div>
</isc-benefits>

<script>
  if (!customElements.get('isc-benefits')) {
    customElements.define(
      'isc-benefits',
      class extends HTMLElement {
        connectedCallback() {
          /* is-visible: prima comparsa (una volta). is-active: animazioni continue finché la sezione è sullo schermo */
          if (!('IntersectionObserver' in window)) return this.classList.add('is-visible', 'is-active');
          this.fallback = setTimeout(() => this.classList.add('is-visible', 'is-active'), 2000);
          this.io = new IntersectionObserver(
            (entries) => entries.forEach((e) => {
              if (e.isIntersecting) {
                clearTimeout(this.fallback);
                this.classList.add('is-visible', 'is-active');
              } else {
                this.classList.remove('is-active');
              }
            }),
            { threshold: 0.15 }
          );
          this.io.observe(this);
        }
        disconnectedCallback() { this.io && this.io.disconnect(); clearTimeout(this.fallback); }
      }
    );
  }
</script>


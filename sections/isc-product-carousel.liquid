{% render 'isc-section-spacing' %}
{%- liquid
  assign s = section.settings
  assign c = s.collection
  assign link = s.link | default: c.url | default: routes.all_products_collection_url
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .isc-pc {
    --pc-cols: {{ s.columns_mobile }};
    --pc-media-bg: {{ s.media_bg }};
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .isc-pc { --pc-cols: {{ s.columns_tablet }}; }
  }
  @media screen and (min-width: 1100px) {
    #shopify-section-{{ section.id }} .isc-pc { --pc-cols: {{ s.columns_desktop }}; }
  }
{%- endstyle -%}

<section class="isc-section isc-pc color-{{ s.color_scheme }} isc-pc--card-{{ s.card_style }} isc-pc--fit-{{ s.image_fit }} isc-pc--ratio-{{ s.image_ratio }}">
  <div class="isc-container">
    <div class="isc-section__head isc-pc__head">
      <div class="isc-section__titles">
        <h2 class="isc-h2{% if s.heading_accent %} isc-pc__heading--accent{% endif %}">{{ s.heading | escape }}</h2>
        {%- if s.subheading != blank -%}
          <span class="isc-section__sub">{{ s.subheading | escape }}</span>
        {%- endif -%}
      </div>
      {%- if s.link_label != blank -%}
        <a href="{{ link }}" class="isc-pc__all isc-pc__all--head">
          {{- s.link_label | escape -}}
          <svg viewBox="0 0 20 10" fill="none" aria-hidden="true"><path d="M.5 5h17M13.2 1.3c.7 1.9 2.3 3.2 4.3 3.7-2 .5-3.6 1.8-4.3 3.7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
    </div>

    <isc-carousel class="isc-pc__frame">
      <button type="button" class="isc-pc__arrow isc-pc__arrow--prev" aria-label="Prodotti precedenti" hidden>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.5 4.5 7.3 9.3a1 1 0 0 0 0 1.4l5.2 4.8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </button>

      <ul class="isc-pc__track list-unstyled" role="list">
        {%- if c != blank and c.products_count > 0 -%}
          {%- for product in c.products limit: s.products_to_show -%}
            <li class="isc-pc__slide">
              {% render 'isc-product-card', product: product, settings_block: s, section_id: section.id %}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..6) -%}
            <li class="isc-pc__slide">
              <div class="isc-pcard">
                <div class="isc-pcard__media">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                <div class="isc-pcard__body">
                  <span class="isc-pcard__title">Nome Prodotto</span>
                  <span class="isc-pcard__price">€ 49,90</span>
                </div>
              </div>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>

      <button type="button" class="isc-pc__arrow isc-pc__arrow--next" aria-label="Prodotti successivi" hidden>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m7.5 4.5 5.2 4.8a1 1 0 0 1 0 1.4l-5.2 4.8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </button>
    </isc-carousel>

    {%- if s.link_label != blank -%}
      <div class="isc-pc__foot">
        <a href="{{ link }}" class="isc-pc__all">
          {{- s.link_label | escape -}}
          <svg viewBox="0 0 20 10" fill="none" aria-hidden="true"><path d="M.5 5h17M13.2 1.3c.7 1.9 2.3 3.2 4.3 3.7-2 .5-3.6 1.8-4.3 3.7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "ISC: carosello prodotti",
  "tag": "div",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collezione"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Numero di prodotti",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Intestazione"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Best seller"
    },
    {
      "type": "checkbox",
      "id": "heading_accent",
      "label": "Lineetta sotto al titolo",
      "default": true
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sottotitolo"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Testo link",
      "default": "Vedi tutti i prodotti"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Se vuoto porta alla collezione."
    },
    {
      "type": "header",
      "content": "Colonne"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Prodotti visibili desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Prodotti visibili tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Prodotti visibili mobile",
      "options": [
        {
          "value": "1.3",
          "label": "1 (e un pezzo del successivo)"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "2.3",
          "label": "2 (e un pezzo del successivo)"
        },
        {
          "value": "2.5",
          "label": "2 e mezzo"
        }
      ],
      "default": "2.5"
    },
    {
      "type": "header",
      "content": "Scheda prodotto"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Stile scheda",
      "options": [
        {
          "value": "bordered",
          "label": "Con bordo"
        },
        {
          "value": "plain",
          "label": "Senza bordo"
        }
      ],
      "default": "plain"
    },
    {
      "type": "color",
      "id": "media_bg",
      "label": "Sfondo foto",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Forma foto",
      "options": [
        {
          "value": "square",
          "label": "Quadrata"
        },
        {
          "value": "portrait",
          "label": "Verticale 4:5"
        },
        {
          "value": "adapt",
          "label": "Come la foto del prodotto"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Adattamento foto",
      "options": [
        {
          "value": "cover",
          "label": "Riempi il riquadro"
        },
        {
          "value": "contain",
          "label": "Foto intera"
        }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "show_secondary",
      "label": "Seconda foto al passaggio del mouse",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Badge sconto / Nuovo / Best seller",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Stelle recensioni (se presenti)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Pallini colore",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Pulsante aggiungi al carrello",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Testo pulsante",
      "default": "Aggiungi al carrello"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Stile pulsante",
      "options": [
        {
          "value": "outline",
          "label": "Bordo"
        },
        {
          "value": "solid",
          "label": "Pieno"
        }
      ],
      "default": "outline"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spazi"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Spazio sopra",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Spazio sotto",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "ISC: carosello prodotti"
    }
  ]
}
{% endschema %}

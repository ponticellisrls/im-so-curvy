{%- liquid
  assign s = section.settings
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .isc-stories {
    --story-size: {{ s.size_mobile }}px;
    --story-circle-bg: {{ s.circle_bg }};
    --story-ring: {{ s.ring_color }};
    --story-zoom: {{ s.image_zoom | divided_by: 100.0 }};
    --story-gap: {{ s.gap_mobile }}px;
    --story-pad-top: {{ s.padding_top | times: 0.75 | round }}px;
    --story-pad-bottom: {{ s.padding_bottom | times: 0.75 | round }}px;
    {%- if s.all_bg != blank and s.all_bg.alpha != 0.0 %}--story-all-bg: {{ s.all_bg }};{%- endif %}
    {%- if s.all_color != blank and s.all_color.alpha != 0.0 %}--story-all-color: {{ s.all_color }};{%- endif %}
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .isc-stories {
      --story-size: {{ s.size }}px;
      --story-gap: {{ s.gap }}px;
      --story-pad-top: {{ s.padding_top }}px;
      --story-pad-bottom: {{ s.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="isc-stories color-{{ s.color_scheme }} isc-stories--ring-{{ s.ring_style }} isc-stories--fit-{{ s.image_fit }} isc-stories--all-{{ s.all_style }}{% if s.blend %} isc-stories--blend{% endif %}{% if s.boxed %} isc-stories--boxed{% endif %}{% if s.dividers %} isc-stories--dividers{% endif %}{% if s.center %} isc-stories--center{% endif %}">
  <div class="isc-container">
    {%- if s.heading != blank -%}
      <div class="isc-stories__head">
        <h2 class="isc-h2">{{ s.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <isc-stories class="isc-stories__frame">
      <button type="button" class="isc-stories__arrow isc-stories__arrow--prev" aria-label="Indietro" hidden>
        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </button>

      <ul class="isc-stories__list list-unstyled" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign c = block.settings.collection
            assign image = block.settings.image | default: c.featured_image
            assign label = block.settings.title | default: c.title | default: 'Categoria'
            assign url = block.settings.link | default: c.url | default: routes.collections_url
          -%}
          <li
            class="isc-story{% if block.settings.ring or s.ring_scope == 'all' %} isc-story--ring{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <a href="{{ url }}" class="isc-story__link">
              <span class="isc-story__circle">
                {%- if block.settings.style == 'graphic' -%}
                  {%- liquid
                    assign spark = '#fbe4ea'
                    case block.settings.palette
                      when 'graphite'
                        assign g1 = '#a3406b'
                        assign g2 = '#3d0c24'
                        assign spark = '#ffffff'
                      when 'mono'
                        assign g1 = '#6b5a61'
                        assign g2 = '#241a1f'
                      when 'taupe'
                        assign g1 = '#c99aa8'
                        assign g2 = '#4a1230'
                      when 'gold'
                        assign g1 = '#e0a0b5'
                        assign g2 = '#660033'
                      when 'red'
                        assign g1 = '#b0123f'
                        assign g2 = '#3d0c24'
                      when 'sunset'
                        assign g1 = '#fa7e1e'
                        assign g2 = '#962fbf'
                      when 'custom'
                        assign g1 = block.settings.color_1
                        assign g2 = block.settings.color_2
                      else
                        assign g1 = '#a3406b'
                        assign g2 = '#3d0c24'
                        assign spark = '#ffffff'
                    endcase
                  -%}
                  <span class="isc-story__img isc-story__graphic" style="--g1: {{ g1 }}; --g2: {{ g2 }}; --spark: {{ spark }};">
                    <span class="isc-story__sheen" aria-hidden="true"></span>
                    <span class="isc-story__spark isc-story__spark--1" aria-hidden="true">✦</span>
                    <span class="isc-story__spark isc-story__spark--2" aria-hidden="true">✦</span>
                    <span class="isc-story__spark isc-story__spark--3" aria-hidden="true">✦</span>
                    <span class="isc-story__gtext" aria-hidden="true">
                      <span class="isc-story__gline1">{{ block.settings.graphic_line_1 | escape }}</span>
                      {%- if block.settings.graphic_line_2 != blank -%}
                        <span class="isc-story__gline2">{{ block.settings.graphic_line_2 | escape }}</span>
                      {%- endif -%}
                    </span>
                  </span>
                {%- else -%}
                <span class="isc-story__img"{% if block.settings.zoom > 0 %} style="--story-zoom: {{ block.settings.zoom | divided_by: 100.0 }};"{% endif %}>
                  {%- if image != blank -%}
                    {{
                      image
                      | image_url: width: 400
                      | image_tag: loading: 'lazy', sizes: '160px', widths: '160, 240, 320, 400', alt: label
                    }}
                  {%- else -%}
                    {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </span>
                {%- endif -%}
                {%- if block.settings.badge != blank -%}
                  <span class="isc-story__badge">{{ block.settings.badge | escape }}</span>
                {%- endif -%}
              </span>
              <span class="isc-story__label">{{ label | escape }}</span>
            </a>
          </li>
        {%- endfor -%}

        {%- if s.show_all -%}
          <li class="isc-story isc-story--all">
            <a href="{{ s.all_link | default: routes.collections_url }}" class="isc-story__link isc-story__all">
              <span class="isc-story__circle isc-story__all-circle">
                <svg class="isc-story__all-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 7.6V7c0-.8.7-1.2 1.3-1.6a2 2 0 1 0-3.1-1.7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                  <path d="M12 7.6l-8.4 6.9c-.9.7-.4 2.1.8 2.1h15.2c1.2 0 1.7-1.4.8-2.1z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
                  <path d="M12 21s-2.4-1.4-2.4-3c0-.7.5-1.3 1.2-1.3.5 0 .9.3 1.2.7.3-.4.7-.7 1.2-.7.7 0 1.2.6 1.2 1.3 0 1.6-2.4 3-2.4 3z" fill="currentColor"/>
                </svg>
                <span class="isc-story__all-label isc-story__all-label--inside">{{ s.all_label | escape }}</span>
              </span>
              <span class="isc-story__label isc-story__all-label--below">{{ s.all_label | escape }}</span>
            </a>
          </li>
        {%- endif -%}
      </ul>

      <button type="button" class="isc-stories__arrow isc-stories__arrow--next" aria-label="Avanti" hidden>
        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </button>
    </isc-stories>
  </div>
</div>

<script>
  if (!customElements.get('isc-stories')) {
    customElements.define(
      'isc-stories',
      class extends HTMLElement {
        connectedCallback() {
          this.list = this.querySelector('.isc-stories__list');
          this.prev = this.querySelector('.isc-stories__arrow--prev');
          this.next = this.querySelector('.isc-stories__arrow--next');
          const step = () => this.list.clientWidth * 0.8;
          this.prev.addEventListener('click', () => this.list.scrollBy({ left: -step(), behavior: 'smooth' }));
          this.next.addEventListener('click', () => this.list.scrollBy({ left: step(), behavior: 'smooth' }));
          this.update = this.update.bind(this);
          this.list.addEventListener('scroll', this.update, { passive: true });
          this.ro = new ResizeObserver(this.update);
          this.ro.observe(this.list);
          this.update();
        }
        disconnectedCallback() {
          this.ro && this.ro.disconnect();
        }
        update() {
          const max = this.list.scrollWidth - this.list.clientWidth;
          const overflow = max > 4;
          this.classList.toggle('is-scrollable', overflow);
          this.prev.hidden = !overflow || this.list.scrollLeft <= 4;
          this.next.hidden = !overflow || this.list.scrollLeft >= max - 4;
        }
      }
    );
  }
</script>

{% schema %}
{
